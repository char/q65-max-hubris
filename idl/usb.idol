Interface(
    name: "Usb",
    ops: {
        "set_reports": (
            doc: "The keyboard's current input state. Accepted immediately; the host gets it when it next polls.",
            args: {
                "reports": "Reports",
            },
            reply: Simple("()"),
            idempotent: true,
        ),
        "is_awake": (
            doc: "Whether a host is configured and not suspended, i.e. whether anyone can see the lights.",
            reply: Simple("bool"),
            idempotent: true,
        ),
        "leds": (
            doc: "The lock-key LED state the host most recently set.",
            reply: Simple("LedReport"),
            idempotent: true,
        ),
    },
)
